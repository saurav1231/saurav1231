# systemd service for the Ayana API (FastAPI + Uvicorn)
# Install: sudo cp deploy/ayana-api.service /etc/systemd/system/ && sudo systemctl enable --now ayana-api
[Unit]
Description=Ayana API (FastAPI)
After=network.target mariadb.service

[Service]
User=ayana
WorkingDirectory=/var/www/ayana/api
ExecStart=/var/www/ayana/api/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
