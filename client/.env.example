# Leave empty when the API is served from the same domain under /api (recommended).
# Set to a full URL only if the API lives on another domain, e.g. https://api.ayana.travel/api
VITE_API_URL=

# Where the Streamlit analytics app (Ayana Insights) is served. Default: same domain under /insights/
# Local development: http://localhost:8501/insights/  (or http://localhost:8501 without --server.baseUrlPath)
VITE_INSIGHTS_URL=
