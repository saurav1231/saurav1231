# ---------- Server ----------
NODE_ENV=development
PORT=4000
# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
# Set to true in production when Express should also serve the built React app (client/dist)
SERVE_CLIENT=false

# ---------- Database (MySQL / MariaDB) ----------
# Local:     mysql://ayana:ayana_pass@localhost:3306/ayana
# Hostinger: mysql://u123456789_ayana:<password>@localhost:3306/u123456789_ayana
DATABASE_URL="mysql://ayana:ayana_pass@localhost:3306/ayana"

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------- Payments ----------
# mock     = no real money, a "Simulate payment" button is shown (good for local dev)
# razorpay = real Razorpay checkout (use rzp_test_ keys first, then rzp_live_ keys)
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Minutes a PENDING booking holds seats before it expires
BOOKING_HOLD_MINUTES=30

# ---------- Seed admin ----------
ADMIN_EMAIL=admin@ayana.travel
ADMIN_PASSWORD=Admin@12345
