# ---------- Server ----------
ENVIRONMENT=development
# Comma separated list of website addresses allowed to call the API
CLIENT_URL=http://localhost:5173
# true = this API also serves the built website from ../client/dist (single-app hosting)
SERVE_CLIENT=false

# ---------- Database (MySQL / MariaDB) ----------
# Local:     mysql+pymysql://ayana:ayana_pass@localhost:3306/ayana
# Hostinger: mysql+pymysql://ayana:<password>@localhost:3306/ayana
DATABASE_URL=mysql+pymysql://ayana:ayana_pass@localhost:3306/ayana

# ---------- Login ----------
# Generate with: python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_DAYS=7

# ---------- Payments ----------
# mock     = no real money, the Pay button confirms instantly (local development)
# razorpay = real Razorpay checkout (rzp_test_ keys first, then rzp_live_ keys)
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Minutes an unpaid booking holds its seats
BOOKING_HOLD_MINUTES=30
# Folder for uploaded photos (relative to api/). Back it up with the database.
UPLOAD_DIR=uploads

# ---------- First admin (used by scripts/seed.py) ----------
ADMIN_EMAIL=admin@ayana.travel
ADMIN_PASSWORD=Admin@12345
